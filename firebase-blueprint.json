{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Inventory product item in RIGUT Boutique",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "price": { "type": "number" },
        "costPrice": { "type": "number" },
        "stock": { "type": "integer" },
        "minStockAlert": { "type": "integer" },
        "sku": { "type": "string" },
        "updatedAt": { "type": "integer" }
      },
      "required": ["id", "name", "price", "stock", "sku"]
    },
    "Sale": {
      "title": "Sale",
      "description": "Store sale transaction recorded from counter or owner",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "receiptNumber": { "type": "string" },
        "timestamp": { "type": "integer" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "sellerName": { "type": "string" },
        "itemsSummary": { "type": "string" },
        "costPriceSnapshot": { "type": "number" },
        "regularPriceSnapshot": { "type": "number" },
        "isRisky": { "type": "boolean" },
        "riskReason": { "type": "string" }
      },
      "required": ["id", "receiptNumber", "timestamp", "totalAmount", "paymentMethod", "sellerName"]
    },
    "CustomerCredit": {
      "title": "CustomerCredit",
      "description": "Customer credit account and balance record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "totalCreditAmount": { "type": "number" },
        "amountPaid": { "type": "number" },
        "remainingBalance": { "type": "number" },
        "startDateTimestamp": { "type": "integer" },
        "dueDateTimestamp": { "type": "integer" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      },
      "required": ["id", "customerName", "customerPhone", "totalCreditAmount", "amountPaid", "remainingBalance"]
    },
    "CashShift": {
      "title": "CashShift",
      "description": "Cash drawer shift audit and reconciliation",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "shiftNumber": { "type": "string" },
        "dateTimestamp": { "type": "integer" },
        "sellerName": { "type": "string" },
        "openingFund": { "type": "number" },
        "expectedCash": { "type": "number" },
        "declaredCash": { "type": "number" },
        "difference": { "type": "number" },
        "totalCard": { "type": "number" },
        "totalTransfer": { "type": "number" },
        "totalCredit": { "type": "number" },
        "totalSalesCount": { "type": "integer" },
        "totalTurnoAmount": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" },
        "closedAtTimestamp": { "type": "integer" }
      },
      "required": ["id", "shiftNumber", "sellerName", "expectedCash", "declaredCash", "status"]
    },
    "StoreDeviceInfo": {
      "title": "StoreDeviceInfo",
      "description": "Terminal status, heartbeat, and seller access permissions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "deviceName": { "type": "string" },
        "sellerName": { "type": "string" },
        "batteryPercentage": { "type": "integer" },
        "isCharging": { "type": "boolean" },
        "isOnline": { "type": "boolean" },
        "lastSyncTimestamp": { "type": "integer" },
        "pendingSalesCount": { "type": "integer" },
        "appVersion": { "type": "string" },
        "sellerPin": { "type": "string" },
        "isSellerAccessEnabled": { "type": "boolean" },
        "requireDailyPin": { "type": "boolean" },
        "canMakeSales": { "type": "boolean" },
        "canApplyDiscounts": { "type": "boolean" },
        "canGrantCredits": { "type": "boolean" },
        "canRegisterPayments": { "type": "boolean" },
        "canViewCostPrices": { "type": "boolean" },
        "canCancelSales": { "type": "boolean" }
      },
      "required": ["id", "deviceName", "sellerName"]
    },
    "AppSettings": {
      "title": "AppSettings",
      "description": "Store application settings and daily goals",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "themeMode": { "type": "string" },
        "accentColorName": { "type": "string" },
        "currencySymbol": { "type": "string" },
        "dailySalesGoal": { "type": "number" },
        "dailyPiecesGoal": { "type": "integer" },
        "notificationsEnabled": { "type": "boolean" },
        "alertRiskySales": { "type": "boolean" },
        "discountAlertThreshold": { "type": "number" }
      },
      "required": ["id", "currencySymbol"]
    }
  },
  "firestore": {
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "Products in user store catalog"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "Sale",
      "description": "Sales records of the store"
    },
    "/users/{userId}/credits/{creditId}": {
      "schema": "CustomerCredit",
      "description": "Customer credit balances"
    },
    "/users/{userId}/shifts/{shiftId}": {
      "schema": "CashShift",
      "description": "Cash register closing shifts"
    },
    "/users/{userId}/device_info/{deviceId}": {
      "schema": "StoreDeviceInfo",
      "description": "Store counter terminal device telemetry and seller permissions"
    },
    "/users/{userId}/settings/{settingsId}": {
      "schema": "AppSettings",
      "description": "Store settings, currency and daily goals"
    }
  }
}
